vendor/
extracted/
*.nro
target/
pikachu-moveset/plugin/target/
.ftp-credentials.local
.console-host.local
!releases/**/*.nro
work/
# Derived from Nintendo assets -- reproducible from tools/, not redistributed via git.
releases/**/*.numshb
releases/**/*.nusktb
releases/**/*.numdlb
releases/**/*.numatb
releases/**/*.numshexb
releases/**/*.adjb
releases/**/*.bin
pikachu-moveset/mod/fighter/pikachu/model/
pikachu-moveset/mod/fighter/pikachu/motion/
disabled-mods/

# Regenerated by tools/gen-buildstamp.sh on every build, so it is dirty by construction and
# committing it would make every commit carry an unrelated one-line diff. The value is in the
# LOG saying which commit ran, not in the file being versioned.
pikachu-moveset/plugin/src/telemetry/buildstamp.rs

# Decompiled C for the game's own modules, produced by tools/decomp-all.sh.
#
# DERIVED AND REPRODUCIBLE, and large: `common` alone is 44 MB across 8792 files and the full
# sweep of all twenty NROs is several hundred. It is also Nintendo's code, which the eight tracked
# asset files already make awkward enough. The script regenerates any module in about ten minutes
# from the NROs in vendor/nro, so the recipe is versioned and the output is not.
vendor/decomp/
work/decomp/

# Every fighter's status scripts, 124 MB, one `tools/fetch-status-scripts.sh` away.
vendor/ssbu-status-all/
work/acquire/

# Reference clones (param-labels, motion lists, prc-rs), 58 MB, see tools/fetch-refs.sh.
vendor/refs/

# Python bytecode from tools/*.py
__pycache__/
*.pyc

# The shipped tree is generated from pikachu-moveset/mod by tools/relocate-slot.sh on every build.
pikachu-moveset/ship/
